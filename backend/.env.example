# --- Database ---
# Local Docker Compose Postgres/PostGIS:
DATABASE_URL=postgresql://samvahak:samvahak@db:5432/samvahak

# Railway will inject its own DATABASE_URL automatically when you attach
# a Postgres plugin to this service — you do not need to set it manually
# in production, only for local dev.

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- App ---
ENVIRONMENT=development
